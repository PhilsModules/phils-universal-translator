<div class="universal-stats-container">
    <div class="universal-stats-header">
        <i class="fas fa-chart-line fa-2x text-accent"></i>
        <h3>Universal Übersetzungs-Statistik</h3>
    </div>

    <div class="universal-stats-grid">
        <div class="universal-stat-box">
            <span class="stat-num">{{stats.translatedWords}}</span>
            <span class="stat-label">Übersetzte Wörter</span>
        </div>
        <div class="universal-stat-box">
            <span class="stat-num">{{stats.grammarWords}}</span>
            <span class="stat-label">Lektorierte Wörter</span>
        </div>
        <div class="universal-stat-box stat-highlight">
            <span class="stat-num">{{stats.hoursSaved}} Std.</span>
            <span class="stat-label">Geschätzte Zeitersparnis</span>
        </div>
    </div>

    <div class="universal-stats-footer">
        <small>Berechnungsgrundlage: ca. 300 Wörter/Std. manuelle Übersetzung, ca. 1.000 Wörter/Std. Lektorat.</small>
    </div>
</div>
